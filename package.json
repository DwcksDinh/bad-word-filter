{
  "name": "@dwcks/bad-word-filter-vi-en",
  "version": "1.1.3",
  "description": "Thư viện lọc từ xấu tiếng Việt và tiếng Anh hỗ trợ Node.js và Browser",
  "main": "dist/node/index.js",
  "module": "dist/esm/index.js",
  "browser": "dist/browser/bad-word-filter.min.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "node": "./dist/esm/index.js",
        "browser": "./dist/browser/bad-word-filter.esm.js",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "node": "./dist/node/index.js",
        "default": "./dist/node/index.js"
      },
      "browser": "./dist/browser/bad-word-filter.min.js",
      "types": "./dist/node/index.d.ts"
    },
    "./node": {
      "import": "./dist/esm/node.js",
      "require": "./dist/node/node.js",
      "types": "./dist/node/node.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/browser.js",
      "browser": "./dist/browser/bad-word-filter.min.js",
      "types": "./dist/browser/browser.d.ts"
    }
  },
  "scripts": {
    "generate:browser-words": "node scripts/generate-browser-words.js",
    "prebuild": "npm run generate:browser-words",
    "build": "npm run build:node && npm run build:esm && npm run build:browser && npm run copy-files",
    "build:node": "tsc -p tsconfig.node.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:browser": "webpack --config webpack.config.js",
    "copy-files": "cp src/bad-words.txt dist/ && cp src/bad-words.txt dist/node/ && cp src/bad-words.txt dist/esm/",
    "test": "ts-node tests/test-bad-word-filter.ts",
    "test:new": "ts-node tests/test-new-api.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bad-word-filter",
    "profanity-filter",
    "typescript",
    "vietnamese",
    "english",
    "browser",
    "node",
    "nextjs"
  ],
  "author": "DwcksDinh",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "files": [
    "dist",
    "src/bad-words.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwcksDinh/bad-word-filter.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
